{
  "name": "cap-maldives",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/to-artifact.mjs",
    "build:pages": "tsc --noEmit && PAGES=1 vite build",
    "preview:pages": "PAGES=1 vite preview --outDir dist-pages",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "web-push": "^3.6.7"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0"
  }
}
